# Docker Compose 使用的镜像名称；对应 https://github.com/qd-today/qd2 发布的最新镜像。
DOCKER_IMAGE=ghcr.io/qd-today/qd2:latest

# QD2 配置和数据库目录；容器数据卷会挂载到该目录。
QD_CONFIG_DIR=/root/.qd2

# 后端监听地址；Docker 中必须监听全部网卡。
QD_HOST=0.0.0.0

# 后端监听端口，同时作为宿主机映射端口。
QD_PORT=8923

# 是否启用开发调试模式；生产环境建议保持 false。
QD_DEBUG=false

# 后端日志级别，可选 DEBUG、INFO、WARNING、ERROR。
QD_LOG_LEVEL=INFO

# 是否启用 Uvicorn 自动重载；Docker 生产环境应保持 false。
QD_RELOAD=false

# 默认语言和地区设置。
QD_LOCALE=zh_CN

# 单个 HTTP 请求的默认超时时间，单位为秒。
QD_REQUEST_TIMEOUT=30

# 单个响应最多保留的字符数，超出部分会截断。
QD_DOWNLOAD_SIZE_LIMIT=50000

# 单次任务运行最多允许发出的 HTTP 请求数，包含重试。
QD_TASK_REQUEST_LIMIT=1500

# 单次任务最长执行时间，单位为秒，不包含任务开始前的随机延迟。
QD_TASK_TIMEOUT=900

# 单个模板 while 循环允许的最大迭代次数。
QD_WHILE_LOOP_LIMIT=10000

# 单个模板 while 循环允许的最长运行时间，单位为秒。
QD_WHILE_LOOP_TIMEOUT=900

# 单个后端进程允许同时执行的最大任务数量。
QD_MAX_CONCURRENT_TASKS=5

# 任务变量、任务 Cookie 和通知配置的固定加密密钥；首次部署后不要修改。
QD_ENCRYPTION_KEY=binux

# JWT 签名密钥；保持默认值时会在数据目录自动生成并持久化随机密钥。
QD_JWT_SECRET=change-me-in-production

# JWT 访问令牌有效期，单位为分钟。
QD_JWT__ACCESS_TOKEN_EXPIRE_MINUTES=15

# JWT 刷新令牌有效期，单位为天。
QD_JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

# 同一客户端 IP 和用户名在统计窗口内允许的失败登录次数；0 表示关闭限制。
QD_LOGIN_RATE_LIMIT=10

# 失败登录次数的统计窗口，单位为秒。
QD_LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600

# QD2 对外访问根地址，用于邮件中的访问链接；未配置域名时留空。
QD_PUBLIC_URL=

# 数据库类型；当前 Docker 默认使用 SQLite。
QD_DB__DB_TYPE=sqlite3

# SQLite 数据库文件在容器内的保存路径。
QD_DB__ENGINE_SETTINGS__DB_PATH=/root/.qd2/database.db

# 邮件通知是否默认使用 SMTP SSL/TLS。
QD_SMTP_SSL=false

# 邮件通知是否默认使用 STARTTLS；不能与 SMTP SSL/TLS 同时开启。
QD_SMTP_STARTTLS=true

# 实时日志 WebSocket 心跳发送间隔，单位为秒。
QD_WS_PING_INTERVAL=5

# 实时日志 WebSocket 等待心跳响应的超时时间，单位为秒。
QD_WS_PING_TIMEOUT=30

# 每个实时日志 WebSocket 连接允许积压的最大消息数。
QD_WS_MAX_QUEUE_SIZE=100

# 单个后端进程允许建立的实时日志 WebSocket 连接总数。
QD_WS_MAX_CONNECTIONS=30
